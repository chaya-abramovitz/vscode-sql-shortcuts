{
  "ssf": { "prefix": "ssf", "description": "SELECT * FROM", "body": ["SELECT *", "FROM $0"] },
  "sf": { "prefix": "sf", "description": "SELECT columns FROM", "body": ["SELECT $1", "FROM $0"] },
  "st1": { "prefix": "st1", "description": "SELECT TOP 1 * FROM", "body": ["SELECT TOP 1 *", "FROM $0"] },
  "st10": { "prefix": "st10", "description": "SELECT TOP 10 * FROM", "body": ["SELECT TOP 10 *", "FROM $0"] },
  "st100": { "prefix": "st100", "description": "SELECT TOP 100 * FROM", "body": ["SELECT TOP 100 *", "FROM $0"] },
  "st1000": { "prefix": "st1000", "description": "SELECT TOP 1000 * FROM", "body": ["SELECT TOP 1000 *", "FROM $0"] },
  "st": { "prefix": "st", "description": "SELECT TOP n columns FROM", "body": ["SELECT TOP $1 $2", "FROM $0"] },
  "sd": { "prefix": "sd", "description": "SELECT DISTINCT ... FROM", "body": ["SELECT DISTINCT $1", "FROM $0"] },
  "scf": { "prefix": "scf", "description": "SELECT COUNT(*) FROM", "body": ["SELECT COUNT(*)", "FROM $0"] },
  "sw": { "prefix": "sw", "description": "SELECT * FROM ... WHERE", "body": ["SELECT *", "FROM $1", "WHERE $0"] },
  "sso": { "prefix": "sso", "description": "SELECT * FROM ... ORDER BY", "body": ["SELECT *", "FROM $1", "ORDER BY $0"] },
  "scg": { "prefix": "scg", "description": "Count rows per group", "body": ["SELECT $2, COUNT(*) AS Cnt", "FROM $1", "GROUP BY $2", "ORDER BY Cnt DESC;$0"] },
  "dupes": { "prefix": "dupes", "description": "Find duplicate values", "body": ["SELECT $2, COUNT(*) AS Cnt", "FROM $1", "GROUP BY $2", "HAVING COUNT(*) > 1", "ORDER BY Cnt DESC;$0"] },
  "w2": { "prefix": "w2", "description": "WHERE", "body": "WHERE $0" },
  "wi": { "prefix": "wi", "description": "WHERE ... IN (...)", "body": "WHERE $1 IN ($0)" },
  "wlk": { "prefix": "wlk", "description": "WHERE ... LIKE '%...%'", "body": "WHERE $1 LIKE '%$0%'" },
  "wb": { "prefix": "wb", "description": "WHERE ... BETWEEN ... AND ...", "body": "WHERE $1 BETWEEN $2 AND $0" },
  "wn": { "prefix": "wn", "description": "WHERE ... IS NULL", "body": "WHERE $1 IS NULL$0" },
  "wnn": { "prefix": "wnn", "description": "WHERE ... IS NOT NULL", "body": "WHERE $1 IS NOT NULL$0" },
  "exs": { "prefix": "exs", "description": "EXISTS (SELECT 1 FROM ...)", "body": ["EXISTS (", "\tSELECT 1", "\tFROM $1", "\tWHERE $0", ")"] },
  "nexs": { "prefix": "nexs", "description": "NOT EXISTS (SELECT 1 FROM ...)", "body": ["NOT EXISTS (", "\tSELECT 1", "\tFROM $1", "\tWHERE $0", ")"] },
  "j": { "prefix": "j", "description": "JOIN ... ON", "body": "JOIN $1 ON $0" },
  "jn": { "prefix": "jn", "description": "JOIN ... ON", "body": "JOIN $1 ON $0" },
  "ij": { "prefix": "ij", "description": "INNER JOIN ... ON", "body": "INNER JOIN $1 ON $0" },
  "lj": { "prefix": "lj", "description": "LEFT JOIN ... ON", "body": "LEFT JOIN $1 ON $0" },
  "rj": { "prefix": "rj", "description": "RIGHT JOIN ... ON", "body": "RIGHT JOIN $1 ON $0" },
  "fj": { "prefix": "fj", "description": "FULL OUTER JOIN ... ON", "body": "FULL OUTER JOIN $1 ON $0" },
  "cj": { "prefix": "cj", "description": "CROSS JOIN", "body": "CROSS JOIN $0" },
  "ca": { "prefix": "ca", "description": "CROSS APPLY (...)", "body": ["CROSS APPLY (", "\t$1", ") $0"] },
  "oa": { "prefix": "oa", "description": "OUTER APPLY (...)", "body": ["OUTER APPLY (", "\t$1", ") $0"] },
  "un": { "prefix": "un", "description": "UNION", "body": ["UNION", "$0"] },
  "ua": { "prefix": "ua", "description": "UNION ALL", "body": ["UNION ALL", "$0"] },
  "ob": { "prefix": "ob", "description": "ORDER BY", "body": "ORDER BY $0" },
  "obd": { "prefix": "obd", "description": "ORDER BY ... DESC", "body": "ORDER BY $1 DESC$0" },
  "gb": { "prefix": "gb", "description": "GROUP BY", "body": "GROUP BY $0" },
  "hv": { "prefix": "hv", "description": "HAVING", "body": "HAVING $0" },
  "ofs": { "prefix": "ofs", "description": "OFFSET ... FETCH NEXT (paging)", "body": ["OFFSET $1 ROWS", "FETCH NEXT $2 ROWS ONLY;$0"] },
  "ii": { "prefix": "ii", "description": "INSERT INTO ... VALUES", "body": ["INSERT INTO $1 ($2)", "VALUES ($0);"] },
  "is": { "prefix": "is", "description": "INSERT INTO ... SELECT", "body": ["INSERT INTO $1 ($2)", "SELECT $3", "FROM $0;"] },
  "ssi": { "prefix": "ssi", "description": "SELECT ... INTO #temp", "body": ["SELECT *", "INTO #$1", "FROM $0;"] },
  "up": { "prefix": "up", "description": "UPDATE ... SET ... WHERE", "body": ["UPDATE $1", "SET $2", "WHERE $0;"] },
  "upj": { "prefix": "upj", "description": "UPDATE with a JOIN", "body": ["UPDATE t", "SET $1", "FROM $2 t", "INNER JOIN $3 ON $0;"] },
  "df": { "prefix": "df", "description": "DELETE FROM ... WHERE", "body": ["DELETE FROM $1", "WHERE $0;"] },
  "mrg": { "prefix": "mrg", "description": "MERGE (insert or update)", "body": ["MERGE $1 AS t", "USING $2 AS s", "\tON $3", "WHEN MATCHED THEN", "\tUPDATE SET $4", "WHEN NOT MATCHED BY TARGET THEN", "\tINSERT ($5)", "\tVALUES ($6);$0"] },
  "tt": { "prefix": "tt", "description": "TRUNCATE TABLE", "body": "TRUNCATE TABLE $0;" },
  "oc": { "prefix": "oc", "description": "OUTPUT inserted.* (see changed rows)", "body": "OUTPUT inserted.*$0" },
  "ct": { "prefix": "ct", "description": "CREATE TABLE", "body": ["CREATE TABLE dbo.$1 (", "\tId INT IDENTITY(1,1) NOT NULL PRIMARY KEY,", "\t$0", ");"] },
  "ctt": { "prefix": "ctt", "description": "CREATE TABLE #temp", "body": ["CREATE TABLE #$1 (", "\t$0", ");"] },
  "dtv": { "prefix": "dtv", "description": "DECLARE @table variable", "body": ["DECLARE @$1 TABLE (", "\t$0", ");"] },
  "at": { "prefix": "at", "description": "ALTER TABLE ... ADD column", "body": "ALTER TABLE $1 ADD $2 $3 NULL;$0" },
  "alc": { "prefix": "alc", "description": "ALTER TABLE ... ALTER COLUMN", "body": "ALTER TABLE $1 ALTER COLUMN $2 $3;$0" },
  "drc": { "prefix": "drc", "description": "ALTER TABLE ... DROP COLUMN", "body": "ALTER TABLE $1 DROP COLUMN $2;$0" },
  "pk": { "prefix": "pk", "description": "Add PRIMARY KEY constraint", "body": "ALTER TABLE $1 ADD CONSTRAINT PK_$1 PRIMARY KEY ($2);$0" },
  "fk": { "prefix": "fk", "description": "Add FOREIGN KEY constraint", "body": "ALTER TABLE $1 ADD CONSTRAINT FK_$1_$2 FOREIGN KEY ($3) REFERENCES $2 ($4);$0" },
  "dfc": { "prefix": "dfc", "description": "Add DEFAULT constraint", "body": "ALTER TABLE $1 ADD CONSTRAINT DF_$1_$2 DEFAULT ($3) FOR $2;$0" },
  "ci": { "prefix": "ci", "description": "CREATE INDEX", "body": "CREATE NONCLUSTERED INDEX IX_$1_$2 ON $1 ($2);$0" },
  "dt": { "prefix": "dt", "description": "DROP TABLE IF EXISTS", "body": "DROP TABLE IF EXISTS $0;" },
  "dv": { "prefix": "dv", "description": "DROP VIEW IF EXISTS", "body": "DROP VIEW IF EXISTS $0;" },
  "dp": { "prefix": "dp", "description": "DROP PROCEDURE IF EXISTS", "body": "DROP PROCEDURE IF EXISTS $0;" },
  "dfn": { "prefix": "dfn", "description": "DROP FUNCTION IF EXISTS", "body": "DROP FUNCTION IF EXISTS $0;" },
  "csc": { "prefix": "csc", "description": "CREATE SCHEMA", "body": "CREATE SCHEMA $0;" },
  "cv": { "prefix": "cv", "description": "CREATE OR ALTER VIEW", "body": ["CREATE OR ALTER VIEW dbo.$1", "AS", "SELECT $2", "FROM $0;", "GO"] },
  "cp": { "prefix": "cp", "description": "CREATE OR ALTER PROCEDURE", "body": ["CREATE OR ALTER PROCEDURE dbo.$1", "\t@$2", "AS", "BEGIN", "\tSET NOCOUNT ON;", "", "\t$0", "END", "GO"] },
  "cf": { "prefix": "cf", "description": "CREATE OR ALTER scalar FUNCTION", "body": ["CREATE OR ALTER FUNCTION dbo.$1 (@$2)", "RETURNS $3", "AS", "BEGIN", "\t$0", "\tRETURN ;", "END", "GO"] },
  "ctf": { "prefix": "ctf", "description": "CREATE OR ALTER inline table FUNCTION", "body": ["CREATE OR ALTER FUNCTION dbo.$1 (@$2)", "RETURNS TABLE", "AS", "RETURN (", "\tSELECT $3", "\tFROM $0", ");", "GO"] },
  "ctr": { "prefix": "ctr", "description": "CREATE OR ALTER TRIGGER", "body": ["CREATE OR ALTER TRIGGER dbo.$1", "ON $2", "AFTER INSERT, UPDATE, DELETE", "AS", "BEGIN", "\tSET NOCOUNT ON;", "", "\t$0", "END", "GO"] },
  "ex": { "prefix": "ex", "description": "EXEC procedure", "body": "EXEC $0;" },
  "cte": { "prefix": "cte", "description": "WITH cte AS (...)", "body": ["WITH $1 AS (", "\t$2", ")", "SELECT *", "FROM $1;$0"] },
  "rn": { "prefix": "rn", "description": "ROW_NUMBER() OVER (...)", "body": "ROW_NUMBER() OVER (PARTITION BY $1 ORDER BY $2) AS RowNum$0" },
  "rk": { "prefix": "rk", "description": "RANK() OVER (...)", "body": "RANK() OVER (PARTITION BY $1 ORDER BY $2) AS Rnk$0" },
  "drk": { "prefix": "drk", "description": "DENSE_RANK() OVER (...)", "body": "DENSE_RANK() OVER (PARTITION BY $1 ORDER BY $2) AS Rnk$0" },
  "lg": { "prefix": "lg", "description": "LAG() OVER (...)", "body": "LAG($1) OVER (PARTITION BY $2 ORDER BY $3)$0" },
  "ld": { "prefix": "ld", "description": "LEAD() OVER (...)", "body": "LEAD($1) OVER (PARTITION BY $2 ORDER BY $3)$0" },
  "rt": { "prefix": "rt", "description": "Running total: SUM() OVER (...)", "body": "SUM($1) OVER (PARTITION BY $2 ORDER BY $3 ROWS UNBOUNDED PRECEDING) AS RunningTotal$0" },
  "cw": { "prefix": "cw", "description": "CASE WHEN ... END", "body": ["CASE", "\tWHEN $1 THEN $2", "\tELSE $3", "END$0"] },
  "pvt": { "prefix": "pvt", "description": "PIVOT", "body": ["SELECT *", "FROM (", "\tSELECT $1", "\tFROM $2", ") src", "PIVOT (", "\t${3:SUM}($4) FOR $5 IN ($6)", ") pvt;$0"] },
  "isn": { "prefix": "isn", "description": "ISNULL(..., ...)", "body": "ISNULL($1, $2)$0" },
  "coa": { "prefix": "coa", "description": "COALESCE(..., ...)", "body": "COALESCE($1, $2)$0" },
  "iif": { "prefix": "iif", "description": "IIF(condition, yes, no)", "body": "IIF($1, $2, $3)$0" },
  "cst": { "prefix": "cst", "description": "CAST(... AS ...)", "body": "CAST($1 AS $2)$0" },
  "tcs": { "prefix": "tcs", "description": "TRY_CAST(... AS ...)", "body": "TRY_CAST($1 AS $2)$0" },
  "cvt": { "prefix": "cvt", "description": "CONVERT(type, value, style)", "body": "CONVERT($1, $2, $3)$0" },
  "gd": { "prefix": "gd", "description": "GETDATE()", "body": "GETDATE()$0" },
  "dta": { "prefix": "dta", "description": "DATEADD(...)", "body": "DATEADD(day, $1, $2)$0" },
  "dtd": { "prefix": "dtd", "description": "DATEDIFF(...)", "body": "DATEDIFF(day, $1, $2)$0" },
  "eom": { "prefix": "eom", "description": "EOMONTH(...)", "body": "EOMONTH($1)$0" },
  "fmt": { "prefix": "fmt", "description": "FORMAT(value, 'format')", "body": "FORMAT($1, '$2')$0" },
  "sagg": { "prefix": "sagg", "description": "STRING_AGG(..., ', ')", "body": "STRING_AGG($1, ', ')$0" },
  "spl": { "prefix": "spl", "description": "STRING_SPLIT(..., ',')", "body": "STRING_SPLIT($1, ',')$0" },
  "nid": { "prefix": "nid", "description": "NEWID()", "body": "NEWID()$0" },
  "sci": { "prefix": "sci", "description": "SCOPE_IDENTITY()", "body": "SCOPE_IDENTITY()$0" },
  "dc": { "prefix": "dc", "description": "DECLARE @variable", "body": "DECLARE @$1 $2 = $3;$0" },
  "ie": { "prefix": "ie", "description": "IF EXISTS (...) BEGIN ... END", "body": ["IF EXISTS (SELECT 1 FROM $1 WHERE $2)", "BEGIN", "\t$0", "END"] },
  "ine": { "prefix": "ine", "description": "IF NOT EXISTS (...) BEGIN ... END", "body": ["IF NOT EXISTS (SELECT 1 FROM $1 WHERE $2)", "BEGIN", "\t$0", "END"] },
  "ife": { "prefix": "ife", "description": "IF ... ELSE", "body": ["IF $1", "BEGIN", "\t$2", "END", "ELSE", "BEGIN", "\t$0", "END"] },
  "be": { "prefix": "be", "description": "BEGIN ... END", "body": ["BEGIN", "\t$0", "END"] },
  "wl": { "prefix": "wl", "description": "WHILE loop", "body": ["WHILE $1", "BEGIN", "\t$0", "END"] },
  "cur": { "prefix": "cur", "description": "Cursor loop", "body": ["DECLARE @$1 INT;", "DECLARE cur CURSOR LOCAL FAST_FORWARD FOR", "\tSELECT $2", "\tFROM $3;", "OPEN cur;", "FETCH NEXT FROM cur INTO @$1;", "WHILE @@FETCH_STATUS = 0", "BEGIN", "\t$0", "\tFETCH NEXT FROM cur INTO @$1;", "END", "CLOSE cur;", "DEALLOCATE cur;"] },
  "pr": { "prefix": "pr", "description": "PRINT", "body": "PRINT $0;" },
  "thr": { "prefix": "thr", "description": "THROW an error", "body": "THROW 50000, '$1', 1;$0" },
  "wt": { "prefix": "wt", "description": "WAITFOR DELAY", "body": "WAITFOR DELAY '00:00:05';$0" },
  "tc": { "prefix": "tc", "description": "TRY ... CATCH with transaction", "body": ["BEGIN TRY", "\tBEGIN TRANSACTION;", "", "\t$0", "", "\tCOMMIT TRANSACTION;", "END TRY", "BEGIN CATCH", "\tIF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;", "\tTHROW;", "END CATCH"] },
  "bt": { "prefix": "bt", "description": "BEGIN TRANSACTION", "body": "BEGIN TRANSACTION;$0" },
  "cmt": { "prefix": "cmt", "description": "COMMIT TRANSACTION", "body": "COMMIT TRANSACTION;$0" },
  "rbt": { "prefix": "rbt", "description": "ROLLBACK TRANSACTION", "body": "ROLLBACK TRANSACTION;$0" },
  "sno": { "prefix": "sno", "description": "SET NOCOUNT ON", "body": "SET NOCOUNT ON;$0" },
  "sxa": { "prefix": "sxa", "description": "SET XACT_ABORT ON", "body": "SET XACT_ABORT ON;$0" },
  "sio": { "prefix": "sio", "description": "SET STATISTICS IO, TIME ON", "body": "SET STATISTICS IO, TIME ON;$0" },
  "nl": { "prefix": "nl", "description": "WITH (NOLOCK)", "body": "WITH (NOLOCK)$0" },
  "jsn": { "prefix": "jsn", "description": "FOR JSON PATH", "body": "FOR JSON PATH$0" },
  "oj": { "prefix": "oj", "description": "OPENJSON(...) WITH (...)", "body": ["SELECT *", "FROM OPENJSON($1)", "WITH (", "\t$0", ");"] },
  "xmlp": { "prefix": "xmlp", "description": "Comma list with FOR XML PATH", "body": ["STUFF((", "\tSELECT ', ' + $1", "\tFROM $2", "\tFOR XML PATH('')", "), 1, 2, '')$0"] },
  "fc": { "prefix": "fc", "description": "Find a column in all tables", "body": ["SELECT TABLE_SCHEMA, TABLE_NAME, COLUMN_NAME, DATA_TYPE", "FROM INFORMATION_SCHEMA.COLUMNS", "WHERE COLUMN_NAME LIKE '%$1%'", "ORDER BY TABLE_NAME;$0"] },
  "ftb": { "prefix": "ftb", "description": "Find a table by name", "body": ["SELECT TABLE_SCHEMA, TABLE_NAME, TABLE_TYPE", "FROM INFORMATION_SCHEMA.TABLES", "WHERE TABLE_NAME LIKE '%$1%'", "ORDER BY TABLE_NAME;$0"] },
  "fp": { "prefix": "fp", "description": "Find text in procedures, views, functions", "body": ["SELECT OBJECT_SCHEMA_NAME(object_id) AS SchemaName, OBJECT_NAME(object_id) AS ObjectName", "FROM sys.sql_modules", "WHERE definition LIKE '%$1%';$0"] },
  "rc": { "prefix": "rc", "description": "Row counts for all tables", "body": ["SELECT s.name AS SchemaName, t.name AS TableName, SUM(p.rows) AS RowCnt", "FROM sys.tables t", "JOIN sys.schemas s ON s.schema_id = t.schema_id", "JOIN sys.partitions p ON p.object_id = t.object_id AND p.index_id IN (0, 1)", "GROUP BY s.name, t.name", "ORDER BY RowCnt DESC;$0"] },
  "cols": { "prefix": "cols", "description": "Columns of a table", "body": ["SELECT COLUMN_NAME, DATA_TYPE, CHARACTER_MAXIMUM_LENGTH, IS_NULLABLE", "FROM INFORMATION_SCHEMA.COLUMNS", "WHERE TABLE_NAME = '$1'", "ORDER BY ORDINAL_POSITION;$0"] },
  "sph": { "prefix": "sph", "description": "sp_help", "body": "EXEC sp_help '$1';$0" },
  "spt": { "prefix": "spt", "description": "sp_helptext (show object code)", "body": "EXEC sp_helptext '$1';$0" },
  "spi": { "prefix": "spi", "description": "sp_helpindex", "body": "EXEC sp_helpindex '$1';$0" },
  "spw": { "prefix": "spw", "description": "sp_who2", "body": "EXEC sp_who2;$0" },
  "go": { "prefix": "go", "description": "GO", "body": ["GO", "$0"] },
  "use": { "prefix": "use", "description": "USE database", "body": ["USE $1;", "GO", "$0"] }
}
