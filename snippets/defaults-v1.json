{
  "ssf": { "prefix": "ssf", "description": "SELECT * FROM", "body": "SELECT * FROM ${1:table}$0" },
  "st100": { "prefix": "st100", "description": "SELECT TOP 100 * FROM", "body": "SELECT TOP 100 * FROM ${1:table}$0" },
  "st1000": { "prefix": "st1000", "description": "SELECT TOP 1000 * FROM", "body": "SELECT TOP 1000 * FROM ${1:table}$0" },
  "st": { "prefix": "st", "description": "SELECT TOP n columns FROM", "body": "SELECT TOP ${1:10} ${2:*} FROM ${3:table}$0" },
  "sd": { "prefix": "sd", "description": "SELECT DISTINCT", "body": "SELECT DISTINCT ${1:column} FROM ${2:table}$0" },
  "scf": { "prefix": "scf", "description": "SELECT COUNT(*) FROM", "body": "SELECT COUNT(*) FROM ${1:table}$0" },
  "sw": { "prefix": "sw", "description": "SELECT * FROM ... WHERE", "body": ["SELECT * FROM ${1:table}", "WHERE ${2:condition}$0"] },
  "w2": { "prefix": "w2", "description": "WHERE", "body": "WHERE ${1:condition}$0" },
  "ij": { "prefix": "ij", "description": "INNER JOIN", "body": "INNER JOIN ${1:table} ${2:t2} ON ${3:t1}.${4:id} = ${2}.${5:id}$0" },
  "lj": { "prefix": "lj", "description": "LEFT JOIN", "body": "LEFT JOIN ${1:table} ${2:t2} ON ${3:t1}.${4:id} = ${2}.${5:id}$0" },
  "rj": { "prefix": "rj", "description": "RIGHT JOIN", "body": "RIGHT JOIN ${1:table} ${2:t2} ON ${3:t1}.${4:id} = ${2}.${5:id}$0" },
  "fj": { "prefix": "fj", "description": "FULL OUTER JOIN", "body": "FULL OUTER JOIN ${1:table} ${2:t2} ON ${3:t1}.${4:id} = ${2}.${5:id}$0" },
  "cj": { "prefix": "cj", "description": "CROSS JOIN", "body": "CROSS JOIN ${1:table}$0" },
  "ca": { "prefix": "ca", "description": "CROSS APPLY", "body": ["CROSS APPLY (", "\t${1:SELECT ...}", ") ${2:x}$0"] },
  "oa": { "prefix": "oa", "description": "OUTER APPLY", "body": ["OUTER APPLY (", "\t${1:SELECT ...}", ") ${2:x}$0"] },
  "ob": { "prefix": "ob", "description": "ORDER BY", "body": "ORDER BY ${1:column}$0" },
  "obd": { "prefix": "obd", "description": "ORDER BY ... DESC", "body": "ORDER BY ${1:column} DESC$0" },
  "gb": { "prefix": "gb", "description": "GROUP BY", "body": "GROUP BY ${1:column}$0" },
  "hv": { "prefix": "hv", "description": "HAVING", "body": "HAVING ${1:COUNT(*) > 1}$0" },
  "dupes": { "prefix": "dupes", "description": "Find duplicate rows", "body": ["SELECT ${2:column}, COUNT(*) AS cnt", "FROM ${1:table}", "GROUP BY ${2}", "HAVING COUNT(*) > 1", "ORDER BY cnt DESC;$0"] },
  "ii": { "prefix": "ii", "description": "INSERT INTO ... VALUES", "body": ["INSERT INTO ${1:table} (${2:columns})", "VALUES (${3:values});$0"] },
  "is": { "prefix": "is", "description": "INSERT INTO ... SELECT", "body": ["INSERT INTO ${1:table} (${2:columns})", "SELECT ${3:columns}", "FROM ${4:source};$0"] },
  "ssi": { "prefix": "ssi", "description": "SELECT ... INTO #temp", "body": ["SELECT ${1:*}", "INTO #${2:temp}", "FROM ${3:table};$0"] },
  "up": { "prefix": "up", "description": "UPDATE ... SET ... WHERE", "body": ["UPDATE ${1:table}", "SET ${2:column} = ${3:value}", "WHERE ${4:condition};$0"] },
  "df": { "prefix": "df", "description": "DELETE FROM ... WHERE", "body": ["DELETE FROM ${1:table}", "WHERE ${2:condition};$0"] },
  "mrg": { "prefix": "mrg", "description": "MERGE (upsert)", "body": ["MERGE ${1:target} AS t", "USING ${2:source} AS s", "\tON t.${3:id} = s.${3}", "WHEN MATCHED THEN", "\tUPDATE SET ${4:t.col = s.col}", "WHEN NOT MATCHED BY TARGET THEN", "\tINSERT (${5:cols}) VALUES (${6:s.cols});$0"] },
  "tt": { "prefix": "tt", "description": "TRUNCATE TABLE", "body": "TRUNCATE TABLE ${1:table};$0" },
  "ct": { "prefix": "ct", "description": "CREATE TABLE", "body": ["CREATE TABLE ${1:dbo}.${2:TableName} (", "\t${3:Id} INT IDENTITY(1,1) NOT NULL PRIMARY KEY,", "\t${4:Name} NVARCHAR(${5:100}) NOT NULL$0", ");"] },
  "ctt": { "prefix": "ctt", "description": "CREATE TABLE #temp", "body": ["CREATE TABLE #${1:temp} (", "\t${2:Id} INT$0", ");"] },
  "dtv": { "prefix": "dtv", "description": "DECLARE @table variable", "body": ["DECLARE @${1:t} TABLE (", "\t${2:Id} INT$0", ");"] },
  "at": { "prefix": "at", "description": "ALTER TABLE ADD column", "body": "ALTER TABLE ${1:dbo}.${2:TableName} ADD ${3:Column} ${4:INT} ${5:NULL};$0" },
  "dt": { "prefix": "dt", "description": "DROP TABLE IF EXISTS", "body": "DROP TABLE IF EXISTS ${1:dbo}.${2:TableName};$0" },
  "ci": { "prefix": "ci", "description": "CREATE INDEX", "body": "CREATE NONCLUSTERED INDEX IX_${1:Table}_${2:Column} ON ${3:dbo}.${1} (${2});$0" },
  "cv": { "prefix": "cv", "description": "CREATE OR ALTER VIEW", "body": ["CREATE OR ALTER VIEW ${1:dbo}.${2:vw_Name}", "AS", "SELECT ${3:*}", "FROM ${4:table};$0", "GO"] },
  "cp": { "prefix": "cp", "description": "CREATE OR ALTER PROCEDURE", "body": ["CREATE OR ALTER PROCEDURE ${1:dbo}.${2:usp_Name}", "\t@${3:Param} ${4:INT}", "AS", "BEGIN", "\tSET NOCOUNT ON;", "", "\t$0", "END", "GO"] },
  "cf": { "prefix": "cf", "description": "CREATE OR ALTER scalar FUNCTION", "body": ["CREATE OR ALTER FUNCTION ${1:dbo}.${2:fn_Name} (@${3:Param} ${4:INT})", "RETURNS ${5:INT}", "AS", "BEGIN", "\tRETURN ${6:@Result};$0", "END", "GO"] },
  "ctf": { "prefix": "ctf", "description": "CREATE OR ALTER inline table FUNCTION", "body": ["CREATE OR ALTER FUNCTION ${1:dbo}.${2:tvf_Name} (@${3:Param} ${4:INT})", "RETURNS TABLE", "AS", "RETURN (", "\tSELECT ${5:*} FROM ${6:table} WHERE ${7:id} = @${3}$0", ");", "GO"] },
  "ex": { "prefix": "ex", "description": "EXEC procedure", "body": "EXEC ${1:dbo}.${2:usp_Name} ${3:@Param = 1};$0" },
  "cte": { "prefix": "cte", "description": "Common table expression", "body": ["WITH ${1:cte} AS (", "\t${2:SELECT * FROM table}", ")", "SELECT * FROM ${1};$0"] },
  "rn": { "prefix": "rn", "description": "ROW_NUMBER() OVER", "body": "ROW_NUMBER() OVER (PARTITION BY ${1:column} ORDER BY ${2:column}) AS ${3:rn}$0" },
  "cw": { "prefix": "cw", "description": "CASE WHEN", "body": ["CASE", "\tWHEN ${1:condition} THEN ${2:value}", "\tELSE ${3:value}", "END$0"] },
  "dc": { "prefix": "dc", "description": "DECLARE variable", "body": "DECLARE @${1:var} ${2:INT} = ${3:0};$0" },
  "ie": { "prefix": "ie", "description": "IF EXISTS", "body": ["IF EXISTS (SELECT 1 FROM ${1:table} WHERE ${2:condition})", "BEGIN", "\t$0", "END"] },
  "ine": { "prefix": "ine", "description": "IF NOT EXISTS", "body": ["IF NOT EXISTS (SELECT 1 FROM ${1:table} WHERE ${2:condition})", "BEGIN", "\t$0", "END"] },
  "be": { "prefix": "be", "description": "BEGIN ... END", "body": ["BEGIN", "\t$0", "END"] },
  "wl": { "prefix": "wl", "description": "WHILE loop", "body": ["WHILE ${1:@i < 10}", "BEGIN", "\t$0", "END"] },
  "tc": { "prefix": "tc", "description": "TRY ... CATCH with transaction", "body": ["BEGIN TRY", "\tBEGIN TRANSACTION;", "", "\t$0", "", "\tCOMMIT TRANSACTION;", "END TRY", "BEGIN CATCH", "\tIF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;", "\tTHROW;", "END CATCH"] },
  "bt": { "prefix": "bt", "description": "BEGIN TRANSACTION", "body": "BEGIN TRANSACTION;$0" },
  "cmt": { "prefix": "cmt", "description": "COMMIT TRANSACTION", "body": "COMMIT TRANSACTION;$0" },
  "rbt": { "prefix": "rbt", "description": "ROLLBACK TRANSACTION", "body": "ROLLBACK TRANSACTION;$0" },
  "cur": { "prefix": "cur", "description": "Cursor loop", "body": ["DECLARE @${1:id} INT;", "DECLARE ${2:cur} CURSOR LOCAL FAST_FORWARD FOR", "\tSELECT ${3:Id} FROM ${4:table};", "OPEN ${2};", "FETCH NEXT FROM ${2} INTO @${1};", "WHILE @@FETCH_STATUS = 0", "BEGIN", "\t$0", "\tFETCH NEXT FROM ${2} INTO @${1};", "END", "CLOSE ${2};", "DEALLOCATE ${2};"] },
  "nl": { "prefix": "nl", "description": "WITH (NOLOCK)", "body": "WITH (NOLOCK)$0" },
  "fc": { "prefix": "fc", "description": "Find column by name in all tables", "body": ["SELECT TABLE_SCHEMA, TABLE_NAME, COLUMN_NAME, DATA_TYPE", "FROM INFORMATION_SCHEMA.COLUMNS", "WHERE COLUMN_NAME LIKE '%${1:name}%'", "ORDER BY TABLE_NAME;$0"] },
  "ftb": { "prefix": "ftb", "description": "Find table by name", "body": ["SELECT TABLE_SCHEMA, TABLE_NAME, TABLE_TYPE", "FROM INFORMATION_SCHEMA.TABLES", "WHERE TABLE_NAME LIKE '%${1:name}%'", "ORDER BY TABLE_NAME;$0"] },
  "fp": { "prefix": "fp", "description": "Find text in procs/views/functions", "body": ["SELECT OBJECT_SCHEMA_NAME(object_id) AS [schema], OBJECT_NAME(object_id) AS [name]", "FROM sys.sql_modules", "WHERE definition LIKE '%${1:text}%';$0"] },
  "rc": { "prefix": "rc", "description": "Row counts for all tables", "body": ["SELECT s.name AS [schema], t.name AS [table], SUM(p.rows) AS [rows]", "FROM sys.tables t", "JOIN sys.schemas s ON s.schema_id = t.schema_id", "JOIN sys.partitions p ON p.object_id = t.object_id AND p.index_id IN (0, 1)", "GROUP BY s.name, t.name", "ORDER BY [rows] DESC;$0"] },
  "sph": { "prefix": "sph", "description": "sp_help", "body": "EXEC sp_help '${1:table}';$0" },
  "spw": { "prefix": "spw", "description": "sp_who2", "body": "EXEC sp_who2;$0" },
  "go": { "prefix": "go", "description": "GO", "body": ["GO", "$0"] },
  "use": { "prefix": "use", "description": "USE database", "body": ["USE ${1:database};", "GO", "$0"] }
}
