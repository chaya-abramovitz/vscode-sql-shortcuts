{
  "name": "sql-shortcuts",
  "displayName": "SQL Shortcuts",
  "description": "T-SQL shortcuts for VS Code: type ssf and press Tab or Space to get SELECT * FROM. 120+ shortcuts, editable in a visual editor.",
  "version": "1.9.0",
  "publisher": "chaya-local",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaya-abramovitz/vscode-sql-shortcuts.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "sql",
    "tsql",
    "t-sql",
    "sql server",
    "snippets",
    "shortcuts",
    "sql prompt"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:mssql",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sqlShortcuts.edit",
        "title": "Edit Shortcuts",
        "category": "SQL Shortcuts",
        "icon": {
          "light": "media/key-light.svg",
          "dark": "media/key-dark.svg"
        }
      },
      {
        "command": "sqlShortcuts.insert",
        "title": "Insert Shortcut…",
        "category": "SQL Shortcuts"
      },
      {
        "command": "sqlShortcuts.import",
        "title": "Import Shortcuts…",
        "category": "SQL Shortcuts"
      },
      {
        "command": "sqlShortcuts.export",
        "title": "Export Shortcuts…",
        "category": "SQL Shortcuts"
      },
      {
        "command": "sqlShortcuts.restoreDefaults",
        "title": "Restore Default Shortcuts…",
        "category": "SQL Shortcuts"
      },
      {
        "command": "sqlShortcuts.editJson",
        "title": "Edit Shortcuts as JSON",
        "category": "SQL Shortcuts"
      },
      {
        "command": "sqlShortcuts.expand",
        "title": "Expand Shortcut",
        "category": "SQL Shortcuts"
      },
      {
        "command": "sqlShortcuts.settings",
        "title": "Settings",
        "category": "SQL Shortcuts"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sqlShortcuts.edit",
          "when": "editorLangId =~ /^(sql|mssql)$/",
          "group": "navigation@99"
        }
      ],
      "editor/context": [
        {
          "command": "sqlShortcuts.insert",
          "when": "editorLangId =~ /^(sql|mssql)$/",
          "group": "1_modification@99"
        }
      ],
      "commandPalette": [
        {
          "command": "sqlShortcuts.expand",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "key": "space",
        "command": "sqlShortcuts.expand",
        "args": {
          "trigger": "space"
        },
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(sql|mssql)$/"
      },
      {
        "key": "tab",
        "command": "sqlShortcuts.expand",
        "args": {
          "trigger": "tab"
        },
        "when": "editorTextFocus && !editorReadonly && !editorHasSelection && !inSnippetMode && !suggestWidgetVisible && !inlineSuggestionVisible && editorLangId =~ /^(sql|mssql)$/"
      },
      {
        "key": "tab",
        "command": "sqlShortcuts.expand",
        "args": {
          "trigger": "tabSuggest"
        },
        "when": "editorTextFocus && !editorReadonly && !editorHasSelection && !inSnippetMode && suggestWidgetVisible && !inlineSuggestionVisible && editorLangId =~ /^(sql|mssql)$/"
      }
    ],
    "configuration": {
      "title": "SQL Shortcuts",
      "properties": {
        "sqlShortcuts.expandOnTab": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "description": "Expand a shortcut when you press Tab after it."
        },
        "sqlShortcuts.expandOnSpace": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "Expand a shortcut when you press Space after it."
        },
        "sqlShortcuts.keywordCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "match"
          ],
          "enumDescriptions": [
            "SELECT * FROM",
            "select * from",
            "Follow how you typed the shortcut: SSF gives SELECT, ssf gives select"
          ],
          "default": "upper",
          "order": 3,
          "description": "Upper or lower case for SQL keywords in expanded shortcuts."
        },
        "sqlShortcuts.layout": {
          "type": "string",
          "enum": [
            "multiLine",
            "compact"
          ],
          "enumDescriptions": [
            "Each clause on its own line: SELECT * / FROM",
            "Short queries on one line: SELECT * FROM"
          ],
          "default": "multiLine",
          "order": 4,
          "description": "How expanded queries are laid out."
        },
        "sqlShortcuts.semicolons": {
          "type": "boolean",
          "default": true,
          "order": 5,
          "description": "End statements with a semicolon (;). MERGE and THROW always keep theirs."
        },
        "sqlShortcuts.showInSuggestions": {
          "type": "boolean",
          "default": true,
          "order": 6,
          "description": "Also list shortcuts in VS Code's suggestion pop-up."
        },
        "sqlShortcuts.showStatusBar": {
          "type": "boolean",
          "default": true,
          "order": 7,
          "description": "Show the Shortcuts button in the status bar while a SQL file is open."
        },
        "sqlShortcuts.spaceExcludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "is",
            "go",
            "use",
            "at",
            "ex",
            "rn",
            "cte",
            "ct",
            "dt",
            "pk",
            "fk",
            "j"
          ],
          "description": "Shortcuts that expand only on Tab, because they are also common SQL words or aliases. Easier to change with the checkbox in Edit Shortcuts.",
          "order": 8
        },
        "sqlShortcuts.shortcutsFile": {
          "type": "string",
          "default": "",
          "description": "Full path to your shortcuts file, e.g. to keep it in OneDrive. Leave empty to use the default location.",
          "order": 9
        }
      }
    }
  }
}
